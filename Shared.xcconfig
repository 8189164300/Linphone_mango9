// Mango9 release identifiers.
// Set MANGO9_DEVELOPMENT_TEAM to the Apple Team ID used for the Mango9 App Store account.
MANGO9_DEVELOPMENT_TEAM =
MANGO9_BUNDLE_ID = com.mango9.phone
MANGO9_MESSAGE_GROUP_NAME = group.com.mango9.phone.msgNotification
MANGO9_SHARE_GROUP_NAME = group.com.mango9.phone.share
// Exact corresponding-source snapshot for Mango9 iOS 6.2.0 (build 6).
MANGO9_SOURCE_CODE_URL = https:/$()/github.com/8189164300/Linphone_mango9/tree/ios-6.2.0-build-6

APP_GROUP_NAME = $(MANGO9_MESSAGE_GROUP_NAME)
