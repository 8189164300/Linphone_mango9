import java.nio.channels.FileChannel;
import java.nio.channels.FileLock;
import java.nio.file.Path;
import java.nio.file.StandardOpenOption;

/** Separate JVM fixture: verify real OS file locks, not just the in-process lock table. */
class AttachmentLeaseProcess {
    public static void main(String[] args) throws Exception {
        try (FileChannel channel = FileChannel.open(Path.of(args[0]), StandardOpenOption.READ, StandardOpenOption.WRITE)) {
            try (FileLock lock = channel.tryLock()) {
                System.out.println(lock == null ? "BUSY" : "ACQUIRED");
                System.out.flush();
                if (lock != null && args[1].equals("hold")) {
                    System.in.read();
                }
            }
        }
    }
}
