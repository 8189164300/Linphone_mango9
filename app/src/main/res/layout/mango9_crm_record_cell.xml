<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="record"
            type="org.linphone.mango9.Mango9CrmRecord" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/squircle_transparent_button_background"
        android:minHeight="76dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/name"
            style="@style/header_style"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@{record.name.empty ? @string/mango9_unnamed_record : record.name}"
            app:layout_constraintEnd_toStartOf="@id/status_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/contact"
            style="@style/default_text_style"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="@{record.phone.empty ? record.email : record.phone}"
            android:textColor="?attr/color_main2_500"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/card_tools"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name" />

        <TextView android:id="@+id/status_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@{record.status}" android:textSize="14sp" android:maxWidth="140dp" android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/card_tools" app:layout_constraintTop_toTopOf="parent"/>

        <TextView android:id="@+id/new_record" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="New" android:textSize="11sp" android:textColor="?attr/color_main1_500" android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/card_tools" app:layout_constraintBottom_toBottomOf="parent" />
        <LinearLayout android:id="@+id/card_tools" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/opportunity" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"
                    android:text="$" android:textSize="23sp" android:textStyle="bold" android:textColor="#168342" android:visibility="gone" android:contentDescription="Opportunities" />
                <TextView android:id="@+id/actions" android:layout_width="40dp" android:layout_height="44dp" android:gravity="center"
                    android:text="⋯" android:textSize="23sp" android:textColor="?attr/color_main1_500" android:contentDescription="Contact actions" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <FrameLayout android:id="@+id/sharing_incoming" android:layout_width="44dp" android:layout_height="44dp" android:visibility="gone" android:contentDescription="Shared with me — show people">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/user_circle" app:tint="#168342" />
                    <TextView android:layout_width="16dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:text="↙" android:textSize="14sp" android:textColor="#168342" />
                </FrameLayout>
                <FrameLayout android:id="@+id/sharing_outgoing" android:layout_width="44dp" android:layout_height="44dp" android:visibility="gone" android:contentDescription="Shared by me — show people">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/user_circle" app:tint="#A47A00" />
                    <TextView android:layout_width="16dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:text="↗" android:textSize="14sp" android:textColor="#A47A00" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
