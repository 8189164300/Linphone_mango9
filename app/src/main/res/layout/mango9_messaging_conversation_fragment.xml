<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/color_grey_100">

        <ImageView
            android:id="@+id/back"
            style="@style/icon_top_bar_button_style"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_height"
            android:contentDescription="@string/content_description_go_back_icon"
            android:src="@drawable/caret_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/color_main1_500" />

        <TextView
            android:id="@+id/title"
            style="@style/default_text_style_800"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_height"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="?attr/color_main1_500"
            android:textSize="17sp"
            app:layout_constraintEnd_toStartOf="@id/more"
            app:layout_constraintStart_toEndOf="@id/back"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ani Paytyan" />

        <ImageView
            android:id="@+id/more"
            style="@style/icon_top_bar_button_style"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_height"
            android:contentDescription="@string/mango9_chat_options"
            android:src="@drawable/dots_three_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/color_main1_500" />

        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@color/bc_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title">

            <View
                android:id="@+id/status_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/mango9_chat_offline_background" />

            <TextView
                android:id="@+id/status"
                style="@style/default_text_style"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="?attr/color_main2_500"
                android:textSize="11sp"
                tools:text="Online" />

            <TextView
                android:id="@+id/transport_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mango9_chat_transport"
                android:textColor="?attr/color_main1_500"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Spinner
            android:id="@+id/sender"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:background="@color/bc_white"
            android:paddingHorizontal="14dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/status_bar"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/search_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:background="@color/bc_white"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sender">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/search_query"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:hint="@string/mango9_chat_search_hint"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:textColor="?attr/color_main2_800"
                    android:textSize="16sp" />
                <ImageButton
                    android:id="@+id/search_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mango9_chat_search_close"
                    android:padding="12dp"
                    android:src="@drawable/x"
                    app:tint="?attr/color_main1_500" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mango9_chat_search_scope"
                android:textSize="12sp"
                android:textColor="?attr/color_main2_500" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/search_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textSize="14sp"
                    android:textColor="?attr/color_main2_700" />
                <ImageButton
                    android:id="@+id/search_previous"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_description_chat_search_message_up"
                    android:padding="12dp"
                    android:src="@drawable/caret_up"
                    app:tint="?attr/color_main1_500" />
                <ImageButton
                    android:id="@+id/search_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_description_chat_search_message_down"
                    android:padding="12dp"
                    android:src="@drawable/caret_down"
                    app:tint="?attr/color_main1_500" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/load_earlier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mango9_more_messages"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/search_panel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@id/composer_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/load_earlier"
            tools:listitem="@layout/mango9_message_cell" />

        <TextView
            android:id="@+id/empty"
            style="@style/default_text_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/mango9_chat_start_conversation"
            android:textColor="?attr/color_main2_500"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/messages"
            app:layout_constraintEnd_toEndOf="@id/messages"
            app:layout_constraintStart_toStartOf="@id/messages"
            app:layout_constraintTop_toTopOf="@id/messages" />

        <LinearLayout
            android:id="@+id/composer_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/bc_white"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="5dp"
                android:textColor="@color/red_danger_500"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Message could not be sent."
                tools:visibility="visible" />

            <Button
                android:id="@+id/retry_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/mango9_chat_retry_history"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/pending_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/pending_attachments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:ignore="UselessParent" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/recording_status"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/mango9_chat_recording"
                android:textColor="@color/red_danger_500"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/attach"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mango9_chat_attach"
                    android:padding="10dp"
                    android:src="@drawable/plus_circle"
                    app:tint="?attr/color_main2_700" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/chat_message_sending_edit_text_background"
                    android:hint="@string/mango9_chat_write_message"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minHeight="44dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:textColor="?attr/color_main2_800"
                    android:textColorHint="?attr/color_main2_400"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/microphone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mango9_chat_record_voice"
                    android:padding="10dp"
                    android:src="@drawable/microphone"
                    app:tint="?attr/color_main2_700" />

                <ImageView
                    android:id="@+id/send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/mango9_chat_send_background"
                    android:contentDescription="@string/mango9_chat_send"
                    android:enabled="false"
                    android:padding="10dp"
                    android:src="@drawable/paper_plane_right"
                    app:tint="@color/bc_white" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:visibility="gone"
            app:indicatorColor="?attr/color_main1_500"
            app:layout_constraintBottom_toBottomOf="@id/messages"
            app:layout_constraintEnd_toEndOf="@id/messages"
            app:layout_constraintStart_toStartOf="@id/messages"
            app:layout_constraintTop_toTopOf="@id/messages" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
