<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="backClickListener" type="View.OnClickListener" />
        <variable name="userGuideClickListener" type="View.OnClickListener" />
        <variable name="privacyPolicyClickListener" type="View.OnClickListener" />
        <variable name="safetySupportClickListener" type="View.OnClickListener" />
        <variable name="licensesClickListener" type="View.OnClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/color_background_contrast_in_dark_mode">

        <ImageView
            android:id="@+id/back"
            style="@style/icon_top_bar_button_style"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:contentDescription="@string/content_description_go_back_icon"
            android:onClick="@{backClickListener}"
            android:src="@drawable/caret_left"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/title"
            app:tint="?attr/color_main1_500" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            style="@style/main_page_title_style"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_height"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="@string/help_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/back"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/color_grey_100"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="@dimen/screen_bottom_margin">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/about_title"
                    style="@style/section_header_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:maxWidth="@dimen/section_max_width"
                    android:text="@string/help_about_title" />

                <LinearLayout
                    android:id="@+id/about_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_squircle_white_background"
                    android:maxWidth="@dimen/section_max_width"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/support_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:onClick="@{userGuideClickListener}"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/book_open_text"
                            app:tint="?attr/color_main1_500" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/header_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mango9_help_support_title" />
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/default_text_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mango9_help_support_subtitle"
                                android:textColor="?attr/color_main2_600"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/arrow_square_out"
                            app:tint="?attr/color_main2_600" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/color_grey_100" />

                    <LinearLayout
                        android:id="@+id/privacy_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:onClick="@{privacyPolicyClickListener}"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/detective"
                            app:tint="?attr/color_main1_500" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/header_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/help_about_privacy_policy_title" />
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/default_text_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mango9_help_privacy_subtitle"
                                android:textColor="?attr/color_main2_600"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/arrow_square_out"
                            app:tint="?attr/color_main2_600" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/color_grey_100" />

                    <LinearLayout
                        android:id="@+id/safety_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:onClick="@{safetySupportClickListener}"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/question"
                            app:tint="?attr/color_main1_500" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/header_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mango9_help_safety_title" />
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/default_text_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mango9_help_safety_subtitle"
                                android:textColor="?attr/color_main2_600"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/arrow_square_out"
                            app:tint="?attr/color_main2_600" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/color_grey_100" />

                    <LinearLayout
                        android:id="@+id/version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="80dp"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/info"
                            app:tint="?attr/color_main1_500" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/header_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/help_about_version_title" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/version_subtitle"
                                style="@style/default_text_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/color_main2_600"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/color_grey_100" />

                    <LinearLayout
                        android:id="@+id/licensing_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:onClick="@{licensesClickListener}"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/check_square_offset"
                            app:tint="?attr/color_main1_500" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/header_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/help_about_open_source_licenses_title" />
                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/default_text_style"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/help_about_open_source_licenses_subtitle"
                                android:textColor="?attr/color_main2_600"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/caret_right"
                            app:tint="?attr/color_main2_600" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
