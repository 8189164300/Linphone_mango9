<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_squircle_white_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/default_text_style_700"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mango9_call_routing_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/line_label"
                    style="@style/default_text_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="?attr/color_main2_500"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/refresh"
                style="@style/icon_top_bar_button_style"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/mango9_call_routing_refresh"
                android:src="@drawable/arrow_clockwise"
                app:tint="?attr/color_main1_500" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="14dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/default_text_style_700"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mango9_call_forwarding_title"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/forwarding_status"
                        style="@style/default_text_style_600"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/mango9_call_forwarding_off"
                        android:textColor="?attr/color_main2_500"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/forwarding_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/mango9_call_forwarding_title" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/mango9_call_forwarding_destination"
                style="?attr/textInputOutlinedStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/save"
                style="@style/default_text_style_600"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/primary_button_background"
                android:text="@string/mango9_call_forwarding_save"
                android:textAllCaps="false"
                android:textColor="@color/bc_white" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_message"
            style="@style/default_text_style_600"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/green_success_500"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error_message"
            style="@style/default_text_style_600"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/red_danger_500"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</layout>
