<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <import type="android.text.InputType" />

        <variable
            name="backClickListener"
            type="View.OnClickListener" />
        <variable
            name="helpClickListener"
            type="View.OnClickListener" />
        <variable
            name="manualSipClickListener"
            type="View.OnClickListener" />
        <variable
            name="qrCodeClickListener"
            type="View.OnClickListener" />
        <variable
            name="viewModel"
            type="org.linphone.ui.assistant.viewmodel.Mango9LoginViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_main2_100">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="8dp">

                    <ImageView
                        android:id="@+id/back"
                        style="@style/icon_top_bar_button_style"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:contentDescription="@string/content_description_go_back_icon"
                        android:onClick="@{backClickListener}"
                        android:src="@drawable/caret_left"
                        android:visibility="@{viewModel.showBackButton ? View.VISIBLE : View.INVISIBLE, default=invisible}"
                        app:tint="?attr/color_main2_600" />

                    <TextView
                        style="@style/assistant_page_title_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/app_name"
                        android:textColor="?attr/color_text" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/icon_top_bar_button_style"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@string/mango9_manual_sip_accessibility"
                            android:onClick="@{manualSipClickListener}"
                            android:padding="11dp"
                            android:src="@drawable/gear"
                            app:tint="?attr/color_main2_600" />

                        <ImageView
                            style="@style/icon_top_bar_button_style"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@string/assistant_scan_qr_code"
                            android:onClick="@{qrCodeClickListener}"
                            android:padding="11dp"
                            android:src="@drawable/qr_code"
                            app:tint="?attr/color_main2_600" />

                        <ImageView
                            style="@style/icon_top_bar_button_style"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@string/help_title"
                            android:onClick="@{helpClickListener}"
                            android:padding="11dp"
                            android:src="@drawable/question"
                            app:tint="?attr/color_main2_600" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mango9_brand_card_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="18dp">

                    <ImageView
                        android:layout_width="176dp"
                        android:layout_height="46dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mango9_wordmark_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/noto_sans_600"
                        android:gravity="center"
                        android:text="@string/mango9_brand_tagline"
                        android:textColor="@color/bc_white"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.85"
                        android:fontFamily="@font/noto_sans_600"
                        android:gravity="center"
                        android:text="@string/mango9_brand_subtitle"
                        android:textColor="@color/bc_white"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/mango9_login_card_background"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/noto_sans_800"
                        android:gravity="center"
                        android:text="@string/mango9_connect_account"
                        android:textColor="?attr/color_text"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/noto_sans"
                        android:gravity="center"
                        android:maxLines="3"
                        android:text="@{viewModel.loginSubtitle}"
                        android:textColor="?attr/color_main2_600"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="@{viewModel.passwordMode ? View.VISIBLE : View.GONE, default=visible}">

                        <EditText
                            style="@style/default_text_style"
                            android:id="@+id/mango9_username"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:autofillHints="username"
                            android:background="@drawable/edit_text_background"
                            android:hint="@string/mango9_username_hint"
                            android:imeOptions="actionNext"
                            android:inputType="text|textNoSuggestions"
                            android:paddingHorizontal="18dp"
                            android:text="@={viewModel.username}"
                            android:textColor="?attr/color_main2_600"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="12dp">

                            <EditText
                                style="@style/default_text_style"
                                android:id="@+id/password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:autofillHints="password"
                                android:background="@drawable/edit_text_background"
                                android:hint="@string/password"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:onEditorAction="@{(view, actionId, event) -> viewModel.primaryActionFromIme()}"
                                android:paddingStart="18dp"
                                android:paddingEnd="52dp"
                                android:text="@={viewModel.password}"
                                android:textColor="?attr/color_main2_600"
                                android:textSize="14sp"
                                passwordInputType="@{viewModel.showPassword ? InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD : InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD, default=textPassword}" />

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:contentDescription="@string/content_description_toggle_password_visibility"
                                android:onClick="@{() -> viewModel.toggleShowPassword()}"
                                android:padding="10dp"
                                android:src="@{viewModel.showPassword ? @drawable/eye_slash : @drawable/eye, default=@drawable/eye}"
                                app:tint="?attr/color_main2_500" />
                        </FrameLayout>
                    </LinearLayout>

                    <EditText
                        style="@style/default_text_style"
                        android:id="@+id/mango9_email"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:autofillHints="emailAddress"
                        android:background="@drawable/edit_text_background"
                        android:hint="@string/mango9_email_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textEmailAddress"
                        android:onEditorAction="@{(view, actionId, event) -> viewModel.primaryActionFromIme()}"
                        android:paddingHorizontal="18dp"
                        android:text="@={viewModel.email}"
                        android:textColor="?attr/color_main2_600"
                        android:textSize="14sp"
                        android:visibility="@{viewModel.emailRequestMode ? View.VISIBLE : View.GONE, default=gone}" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="@{viewModel.emailVerificationMode ? View.VISIBLE : View.GONE, default=gone}">

                        <EditText
                            style="@style/default_text_style"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:autofillHints="smsOTPCode"
                            android:background="@drawable/edit_text_background"
                            android:gravity="center"
                            android:hint="@string/mango9_code_hint"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="6"
                            android:onEditorAction="@{(view, actionId, event) -> viewModel.primaryActionFromIme()}"
                            android:text="@={viewModel.verificationCode}"
                            android:textColor="?attr/color_main2_600"
                            android:textSize="24sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/default_text_style"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical"
                                android:onClick="@{() -> viewModel.changeEmail()}"
                                android:text="@string/mango9_change_email"
                                android:textColor="?attr/color_main1_500"
                                android:textSize="13sp" />

                            <TextView
                                style="@style/default_text_style"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:enabled="@{viewModel.resendCountdown == 0 &amp;&amp; !viewModel.inProgress}"
                                android:gravity="end|center_vertical"
                                android:onClick="@{() -> viewModel.resendCode()}"
                                android:text="@{viewModel.resendButtonTitle}"
                                android:textColor="?attr/color_main1_500"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/default_text_style"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mango9_keep_signed_in"
                                android:textColor="?attr/color_text"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/default_text_style"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/mango9_secure_storage_note"
                                android:textColor="?attr/color_main2_500"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            style="@style/material_switch_style"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="@={viewModel.rememberLogin}" />
                    </LinearLayout>

                    <TextView
                        style="@style/default_text_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@{viewModel.errorMessage}"
                        android:textColor="@color/red_danger_500"
                        android:textSize="13sp"
                        android:visibility="@{viewModel.errorMessage != null ? View.VISIBLE : View.GONE, default=gone}" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp">

                        <TextView
                            style="@style/primary_button_label_style"
                            android:id="@+id/mango9_primary_action"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/primary_button_background"
                            android:enabled="@{viewModel.primaryActionEnabled}"
                            android:gravity="center"
                            android:onClick="@{() -> viewModel.primaryAction()}"
                            android:text="@{viewModel.primaryButtonTitle}" />

                        <ProgressBar
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="18dp"
                            android:indeterminateTint="@color/bc_white"
                            android:visibility="@{viewModel.inProgress ? View.VISIBLE : View.GONE, default=gone}" />
                    </FrameLayout>

                    <TextView
                        style="@style/secondary_button_label_style"
                        android:id="@+id/mango9_use_email_code"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/secondary_button_background"
                        app:drawableStartCompat="@drawable/envelope_simple"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:onClick="@{() -> viewModel.showEmailLogin()}"
                        android:text="@string/mango9_use_email_code"
                        android:visibility="@{viewModel.passwordMode ? View.VISIBLE : View.GONE, default=visible}"
                        app:drawableTint="?attr/color_main1_500" />

                    <TextView
                        style="@style/default_text_style"
                        android:id="@+id/mango9_use_password"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:onClick="@{() -> viewModel.showPasswordLogin()}"
                        android:text="@string/mango9_use_password"
                        android:textColor="?attr/color_main1_500"
                        android:textSize="14sp"
                        android:visibility="@{viewModel.passwordMode ? View.GONE : View.VISIBLE, default=gone}" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
