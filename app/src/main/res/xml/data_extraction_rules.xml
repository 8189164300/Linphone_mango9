<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="encrypted.pref.xml"/>
        <exclude domain="sharedpref" path="mango9_session_metadata.xml"/>
        <exclude domain="sharedpref" path="mango9_session_secrets.xml"/>
        <exclude domain="sharedpref" path="mango9_device.xml"/>
        <exclude domain="sharedpref" path="mango9_managed_configuration_secrets.xml"/>
        <exclude domain="sharedpref" path="mango9_line_identity.xml"/>
        <exclude domain="sharedpref" path="mango9_chat_moderation.xml"/>
        <exclude domain="sharedpref" path="mango9_message_push.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="encrypted.pref.xml"/>
        <exclude domain="sharedpref" path="mango9_session_metadata.xml"/>
        <exclude domain="sharedpref" path="mango9_session_secrets.xml"/>
        <exclude domain="sharedpref" path="mango9_device.xml"/>
        <exclude domain="sharedpref" path="mango9_managed_configuration_secrets.xml"/>
        <exclude domain="sharedpref" path="mango9_line_identity.xml"/>
        <exclude domain="sharedpref" path="mango9_chat_moderation.xml"/>
        <exclude domain="sharedpref" path="mango9_message_push.xml"/>
    </device-transfer>
</data-extraction-rules>
