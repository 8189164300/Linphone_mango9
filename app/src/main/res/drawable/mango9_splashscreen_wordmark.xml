<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android scales the complete splash drawable into a masked icon box.
         A square canvas keeps the wide iOS wordmark inside the safe area. -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="288dp"
                android:height="288dp" />
            <solid android:color="@color/orange_main_500" />
        </shape>
    </item>

    <item
        android:width="108dp"
        android:height="35dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/mango9_wordmark_white" />
    </item>
</layer-list>
