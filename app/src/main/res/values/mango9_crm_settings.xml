    <string name="mango9_crm_settings_title">CRM Settings</string>
    <string name="mango9_crm_scope">These preferences apply to the selected CRM account. Message-push choices apply to all its Mango9 devices; calls and other accounts are not changed. Tap Save CRM settings to apply your changes.</string>
