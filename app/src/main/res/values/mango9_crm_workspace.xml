<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="mango9_crm_calendar_description">Your schedule by month, week or day</string>
    <string name="mango9_crm_activities_description">Appointments, events and tasks</string>
    <style name="Mango9.Crm.WorkspaceRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/shape_squircle_white_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">70dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">13dp</item>
    </style>
    <style name="Mango9.Crm.Chevron" parent="">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/caret_right</item>
        <item name="android:tint">?attr/color_main2_500</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
