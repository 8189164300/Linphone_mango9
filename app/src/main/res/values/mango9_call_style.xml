    </style>
    <style name="Mango9CallNumpadButton" parent="numpad_button_style">
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="Mango9CallPalette" parent="Mango9CallPaletteBase" />
    <style name="Mango9CallPaletteBase" parent="">
        <item name="android:windowBackground">@color/mango9_call_canvas</item>
        <item name="android:colorBackground">@color/mango9_call_canvas</item>
        <item name="android:textColorPrimary">@color/mango9_call_ink</item>
        <item name="android:textColorSecondary">@color/mango9_call_secondary</item>
        <item name="colorSurface">@color/mango9_call_tray</item>
        <item name="colorOnSurface">@color/mango9_call_ink</item>
        <item name="colorPrimary">@color/mango9_call_accent</item>
        <item name="colorOnPrimary">@color/bc_white</item>
        <item name="color_main1_500">@color/mango9_call_accent</item>
        <item name="color_main1_100">@color/mango9_call_control</item>
