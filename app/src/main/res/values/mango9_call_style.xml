        <item name="color_main2_600">@color/mango9_call_secondary</item>
        <item name="color_main2_700">@color/mango9_call_ink</item>
        <item name="color_main2_800">@color/mango9_call_ink</item>
        <item name="color_main2_900">@color/mango9_call_ink</item>
        <item name="color_grey_100">@color/mango9_call_tray</item>
        <item name="color_grey_200">@color/mango9_call_control</item>
        <item name="color_grey_300">@color/mango9_call_divider</item>
        <item name="color_grey_400">@color/mango9_call_disabled</item>
        <item name="color_grey_500">@color/mango9_call_secondary</item>
        <item name="color_grey_600">@color/mango9_call_secondary</item>
        <item name="color_grey_800">@color/mango9_call_ink</item>
        <item name="color_grey_900">@color/mango9_call_ink</item>
        <item name="color_text">@color/mango9_call_ink</item>
        <item name="color_hint_text">@color/mango9_call_secondary</item>
        <item name="color_separator">@color/mango9_call_divider</item>
        <item name="color_background_contrast_in_dark_mode">@color/mango9_call_canvas</item>
        <item name="color_bottom_sheet_background">@color/mango9_call_tray</item>
        <item name="color_bottom_sheet_handle">@color/mango9_call_secondary</item>
        <item name="color_bottom_sheet_disabled_menu">@color/mango9_call_disabled</item>
