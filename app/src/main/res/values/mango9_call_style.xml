<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fixed Mango9 call palette; video and security warnings retain their own contrast. -->
    <color name="mango9_call_canvas">#FFFFFF</color>
    <color name="mango9_call_tray">#F5F6FA</color>
    <color name="mango9_call_control">#E9EDF3</color>
    <color name="mango9_call_divider">#DDE3EB</color>
    <color name="mango9_call_accent">#4053C8</color>
    <color name="mango9_call_ink">#22334D</color>
    <color name="mango9_call_secondary">#4E6074</color>
    <color name="mango9_call_disabled">#68788D</color>
    <color name="mango9_call_destructive">#DD5F5F</color>
    <color name="mango9_call_destructive_pressed">#BF4D4D</color>
